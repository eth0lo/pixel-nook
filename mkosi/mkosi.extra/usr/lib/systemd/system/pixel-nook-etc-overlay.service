[Unit]
Description=Prepare writable account database overlay for /etc
DefaultDependencies=no
After=local-fs.target
Before=basic.target accounts-daemon.service display-manager.service gdm.service gnome-initial-setup.service
RequiresMountsFor=/var/lib/pixel-nook/etc-overlay

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/pixel-nook/setup-etc-overlay

[Install]
WantedBy=basic.target
