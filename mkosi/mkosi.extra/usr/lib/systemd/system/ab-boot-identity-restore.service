[Unit]
Description=Restore persisted Phase 2 identity files into /etc
DefaultDependencies=no
RequiresMountsFor=/var/lib/ab-boot/etc /etc
After=local-fs.target
Before=sysinit.target display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/ab-boot/identity-sync restore

[Install]
WantedBy=sysinit.target
